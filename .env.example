# mca API configuration. Copy to a private location and export in your shell.
# Never commit real secrets; only MCA_API_KEY or DEEPSEEK_API_KEY is required.

# Preferred key name (checked first).
MCA_API_KEY=

# Compatibility fallback (used when MCA_API_KEY is unset).
DEEPSEEK_API_KEY=

# Optional overrides (defaults shown as comments).
# MCA_BASE_URL=https://api.deepseek.com
# MCA_MODEL=deepseek-v4-flash
# MCA_CONTEXT_WINDOW=65536
