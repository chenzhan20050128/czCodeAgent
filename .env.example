# mca API configuration. Copy to a private location and export in your shell.
# Never commit real secrets; only MCA_API_KEY or DEEPSEEK_API_KEY is required.

# Preferred key name (checked first).
MCA_API_KEY=

# Compatibility fallback (used when MCA_API_KEY is unset).
DEEPSEEK_API_KEY=

# Optional overrides (defaults shown as comments).
# MCA_BASE_URL=https://api.deepseek.com
# MCA_MODEL=deepseek-v4-flash
# DeepSeek V4 Flash supports a 1M context window. mca defaults to this value.
# MCA_CONTEXT_WINDOW=1000000
# Local output budget for one model sample. Default: 512000. DeepSeek requests are capped at 384000.
# MCA_MAX_OUTPUT_TOKENS=512000
# DeepSeek thinking mode. Default: enabled.
# MCA_THINKING=enabled
# Long coding tasks may need multiple investigate/fix/verify cycles. Default: 64.
# MCA_MAX_STEPS=64
# Deep thinking / 384K-output requests can exceed ordinary HTTP timeouts. Defaults: 600 / 900 seconds.
# MCA_REQUEST_TIMEOUT=600
# MCA_RETRY_BUDGET_SECONDS=900
